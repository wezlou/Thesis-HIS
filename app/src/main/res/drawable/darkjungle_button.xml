<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_pressed="true">
        <shape>
            <solid android:color="#1A4035" />
            <corners android:radius="18dp" />
            <stroke android:width="2dp" android:color="#A2F2C2" />
        </shape>
    </item>

    <item>
        <shape>
            <solid android:color="#11332B" />
            <corners android:radius="18dp" />
            <stroke android:width="2dp" android:color="#4A6F5A" />
        </shape>
    </item>

</selector>
