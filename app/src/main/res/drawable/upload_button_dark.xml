<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Pressed -->
    <item android:state_pressed="true">
        <shape>
            <solid android:color="#1B3A2E"/>
            <corners android:radius="16dp"/>
            <stroke android:color="#00FF99" android:width="2dp"/>
        </shape>
    </item>

    <!-- Default -->
    <item>
        <shape>
            <solid android:color="#10251B"/>
            <corners android:radius="16dp"/>
            <stroke android:color="#145A32" android:width="2dp"/>
        </shape>
    </item>

</selector>
