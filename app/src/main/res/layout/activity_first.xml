<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/img_31"
    tools:context=".firstActivity">

    <!-- ================= HEADER (TRANSPARENT) ================= -->
    <LinearLayout
        android:id="@+id/headerContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@android:color/transparent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.cardview.widget.CardView
            android:id="@+id/headerCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="8dp"
            app:cardBackgroundColor="@android:color/transparent"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Back button -->
                <ImageView
                    android:id="@+id/backbtn"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="?selectableItemBackgroundBorderless"
                    android:src="@drawable/img_15"
                    android:contentDescription="Back" />

                <!-- Spacer -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center" />

                <!-- Settings button -->
                <ImageView
                    android:id="@+id/settingsButton"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="?selectableItemBackgroundBorderless"
                    android:src="@drawable/settingg"
                    android:contentDescription="Settings" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <View
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:background="@android:color/transparent" />
    </LinearLayout>

    <!-- ================= LEVEL TEXT ================= -->
    <TextView
        android:id="@+id/levelText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/kavoon_regular"
        android:text=""
        android:textAlignment="center"
        android:textColor="#000"
        android:textSize="28sp"
        android:textStyle="bold|italic"
        app:layout_constraintTop_toBottomOf="@id/headerContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp" />

    <!-- ================= SCROLL BACKGROUND ================= -->
    <ImageView
        android:id="@+id/scrollBackground"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:adjustViewBounds="true"
        android:scaleType="fitCenter"
        app:layout_constraintWidth_percent="0.9"
        app:layout_constraintTop_toBottomOf="@id/levelText"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/footerContainer"
        app:srcCompat="@drawable/img_2" />

    <!-- ================= SCROLL CONTENT ================= -->
    <LinearLayout
        android:id="@+id/scrollContent"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingTop="40dp"
        android:paddingBottom="24dp"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        app:layout_constraintTop_toTopOf="@id/scrollBackground"
        app:layout_constraintBottom_toBottomOf="@id/scrollBackground"
        app:layout_constraintStart_toStartOf="@id/scrollBackground"
        app:layout_constraintEnd_toEndOf="@id/scrollBackground">

        <!-- Question -->
        <TextView
            android:id="@+id/questionText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="70dp"
            android:fontFamily="@font/kavoon_regular"
            android:text="What color is the apple??"
            android:textAlignment="center"
            android:textColor="#000"
            android:textSize="24sp"
            android:textStyle="bold|italic" />

        <!-- Apple art -->
        <ImageView
            android:id="@+id/appleImage"
            android:layout_width="180dp"
            android:layout_height="160dp"
            android:layout_marginTop="5dp"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"
            app:srcCompat="@drawable/redapple" />

        <!-- Buttons row -->
        <LinearLayout
            android:id="@+id/choicesLayout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/redbutton"
                android:layout_width="110dp"
                android:layout_height="110dp"
                android:layout_margin="4dp"
                app:srcCompat="@drawable/img_34" />

            <ImageView
                android:id="@+id/bluebutton"
                android:layout_width="110dp"
                android:layout_height="110dp"
                android:layout_margin="4dp"
                app:srcCompat="@drawable/img_38" />

            <ImageView
                android:id="@+id/pinkbutton"
                android:layout_width="110dp"
                android:layout_height="110dp"
                android:layout_margin="4dp"
                app:srcCompat="@drawable/img_33" />
        </LinearLayout>
    </LinearLayout>

    <!-- ================= FOOTER ================= -->
    <LinearLayout
        android:id="@+id/footerContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:background="@android:color/transparent"
        app:layout_constraintTop_toBottomOf="@id/scrollBackground"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
