<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/forestBackground"
    android:fitsSystemWindows="true">

    <!-- Top App Bar -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="@color/forestPrimary"
        android:elevation="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <ImageView
            android:id="@+id/backbtn"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/baseline_arrow_circle_left_24"
            android:tint="@color/forestCard" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Student Tasks"
            android:textColor="@color/forestCard"
            android:textSize="20sp" />

        <ImageView
            android:id="@+id/settingsButton"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/settingg"
            android:tint="@color/forestCard" />
    </LinearLayout>

    <!-- Filter Tabs -->
    <HorizontalScrollView
        android:id="@+id/filterScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/topBar"
        android:fillViewport="true"
        android:padding="8dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/filterAll"
                style="@style/FilterTab"
                android:text="All"
                android:background="@drawable/filter_tab_selected_bg"
                android:textColor="@color/forestCard"/>

            <TextView
                android:id="@+id/filterText"
                style="@style/FilterTab"
                android:text="Text" />

            <TextView
                android:id="@+id/filterImages"
                style="@style/FilterTab"
                android:text="Images" />

            <TextView
                android:id="@+id/filterVideos"
                style="@style/FilterTab"
                android:text="Videos" />

            <TextView
                android:id="@+id/filterPdfs"
                style="@style/FilterTab"
                android:text="PDFs" />

            <TextView
                android:id="@+id/filterDocs"
                style="@style/FilterTab"
                android:text="Docs" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Scrollable List -->
    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/bottomSpacer"
        android:layout_below="@id/filterScroll"
        android:fillViewport="true"
        android:padding="12dp">

        <LinearLayout
            android:id="@+id/assignedTasksContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="100dp" />
    </ScrollView>

    <!-- Empty Message -->
    <TextView
        android:id="@+id/emptyMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:gravity="center"
        android:text="No tasks or announcements yet 📭"
        android:textColor="@color/forestMuted"
        android:textSize="16sp"
        android:visibility="gone" />

    <!-- Spacer -->
    <View
        android:id="@+id/bottomSpacer"
        android:layout_width="match_parent"
        android:layout_height="16dp"
        android:layout_alignParentBottom="true" />

</RelativeLayout>
