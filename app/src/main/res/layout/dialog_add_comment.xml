<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/forestBackground"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Title -->
    <TextView
        android:id="@+id/commentTaskTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Task Title"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/forestPrimaryDark"
        android:gravity="center_horizontal"
        android:layout_marginBottom="12dp" />

    <!-- Comments Scroll -->
    <ScrollView
        android:id="@+id/commentScrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:overScrollMode="always"
        android:scrollbars="vertical">

        <LinearLayout
            android:id="@+id/commentsList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="10dp"
        android:background="@color/forestPrimaryDark" />

    <!-- Comment input area -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/input_rounded"
        android:padding="10dp"
        android:gravity="center_vertical">

        <EditText
            android:id="@+id/commentInput"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:hint="Add a comment..."
            android:textSize="15sp"
            android:background="@android:color/transparent"
            android:padding="6dp"
            android:maxLines="3"
            android:textColor="@color/forestText"
            android:textColorHint="@color/forestMuted"/>

        <Button
            android:id="@+id/sendCommentButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Send"
            android:background="@drawable/btn_forest"
            android:textColor="@color/forestCard"
            android:minHeight="0dp"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp"
            android:textSize="14sp"
            android:layout_marginStart="8dp" />
    </LinearLayout>
</LinearLayout>
