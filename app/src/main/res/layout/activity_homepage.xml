<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/video_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/kd"
    tools:context=".Homepage">

    <!-- HEADER -->
    <ImageView
        android:id="@+id/imageView2"
        android:layout_width="78dp"
        android:layout_height="77dp"
        android:layout_marginStart="32dp"
        android:layout_marginTop="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/kl" />

    <TextView
        android:id="@+id/textView10"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="36dp"
        android:fontFamily="@font/kavoon_regular"
        android:text="HOLY INFANT SCHOOL"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toStartOf="@+id/teachersetting"
        app:layout_constraintStart_toEndOf="@id/imageView2"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/textView11"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/kavoon_regular"
        android:text="OF"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/textView10"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/textView12"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/kavoon_regular"
        android:text="TAGBILARAN CITY"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/textView11"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ImageView
        android:id="@+id/teachersetting"
        android:layout_width="70dp"
        android:layout_height="70dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/settingg" />

    <!-- VOLUME ICONS -->
    <ImageView
        android:id="@+id/volumeOn"
        android:layout_width="67dp"
        android:layout_height="42dp"
        android:visibility="invisible"
        app:layout_constraintTop_toBottomOf="@id/teachersetting"
        app:layout_constraintEnd_toEndOf="parent"
        app:srcCompat="@drawable/om" />

    <ImageView
        android:id="@+id/volumeOff"
        android:layout_width="67dp"
        android:layout_height="42dp"
        android:visibility="invisible"
        app:layout_constraintTop_toBottomOf="@id/volumeOn"
        app:layout_constraintEnd_toEndOf="parent"
        app:srcCompat="@drawable/mute" />

    <!-- WOOD SIGN -->
    <ImageView
        android:id="@+id/woodSign"
        android:layout_width="235dp"
        android:layout_height="421dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:srcCompat="@drawable/img_13" />

    <!-- BUTTONS -->
    <Button
        android:id="@+id/student_login"
        android:layout_width="208dp"
        android:layout_height="55dp"
        android:layout_marginTop="60dp"
        android:background="@android:color/transparent"
        android:fontFamily="@font/luckiestguy"
        android:text="Student Login"
        android:textColor="@android:color/white"
        android:textSize="22sp"
        android:textStyle="bold|italic"
        app:layout_constraintTop_toTopOf="@id/woodSign"
        app:layout_constraintStart_toStartOf="@id/woodSign"
        app:layout_constraintEnd_toEndOf="@id/woodSign" />

    <Button
        android:id="@+id/faculty_login"
        android:layout_width="200dp"
        android:layout_height="50dp"
        android:layout_marginTop="12dp"
        android:background="@android:color/transparent"
        android:fontFamily="@font/luckiestguy"
        android:text="Faculty Login"
        android:textColor="@android:color/white"
        android:textSize="22sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/student_login"
        app:layout_constraintStart_toStartOf="@id/woodSign"
        app:layout_constraintEnd_toEndOf="@id/woodSign" />

    <Button
        android:id="@+id/exit"
        android:layout_width="200dp"
        android:layout_height="50dp"
        android:layout_marginTop="20dp"
        android:background="@android:color/transparent"
        android:fontFamily="@font/luckiestguy"
        android:text="EXIT"
        android:textColor="@android:color/white"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/faculty_login"
        app:layout_constraintStart_toStartOf="@id/woodSign"
        app:layout_constraintEnd_toEndOf="@id/woodSign" />

    <!-- 🌿 STUDENT LOGIN OVERLAY (JUNGLE THEME) -->
    <LinearLayout
        android:id="@+id/studentLoginOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#B3202020"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="20dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="320dp"
            android:layout_height="wrap_content"
            android:background="@drawable/jungle_box"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🌿 Student Login"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#2E7D32"
                android:layout_gravity="center"
                android:layout_marginBottom="16dp" />

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Email"
                app:boxBackgroundMode="filled"
                app:boxBackgroundColor="#E8F5E9"
                app:boxStrokeColor="#2E7D32"
                app:endIconTint="#2E7D32"
                android:layout_marginTop="10dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/studentEmail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textEmailAddress"
                    android:textColor="#1B5E20"
                    android:padding="12dp" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Password"
                app:boxBackgroundMode="filled"
                app:boxBackgroundColor="#E8F5E9"
                app:boxStrokeColor="#2E7D32"
                app:endIconMode="password_toggle"
                app:endIconTint="#2E7D32"
                android:layout_marginTop="12dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/studentPassword"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPassword"
                    android:textColor="#1B5E20"
                    android:padding="12dp" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:id="@+id/forgotStudentPassword"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Forgot Password?"
                android:textColor="#388E3C"
                android:layout_gravity="end"
                android:paddingTop="4dp"/>

            <Button
                android:id="@+id/studentLoginButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Login"
                android:layout_marginTop="10dp"
                android:backgroundTint="#388E3C"
                android:textColor="#FFFFFF"/>

            <Button
                android:id="@+id/closeStudentOverlay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Close"
                android:layout_marginTop="5dp"
                android:backgroundTint="#B71C1C"
                android:textColor="#FFFFFF"/>
        </LinearLayout>
    </LinearLayout>

    <!-- 🌿 FACULTY LOGIN OVERLAY (JUNGLE THEME) -->
    <LinearLayout
        android:id="@+id/facultyLoginOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#B3202020"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="20dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="320dp"
            android:layout_height="wrap_content"
            android:background="@drawable/jungle_box"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🍃 Faculty Login"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#2E7D32"
                android:layout_gravity="center"
                android:layout_marginBottom="16dp" />

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Email"
                app:boxBackgroundMode="filled"
                app:boxBackgroundColor="#E8F5E9"
                app:boxStrokeColor="#2E7D32"
                app:endIconTint="#2E7D32"
                android:layout_marginTop="10dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/facultyEmail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textEmailAddress"
                    android:textColor="#1B5E20"
                    android:padding="12dp" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Password"
                app:boxBackgroundMode="filled"
                app:boxBackgroundColor="#E8F5E9"
                app:boxStrokeColor="#2E7D32"
                app:endIconMode="password_toggle"
                app:endIconTint="#2E7D32"
                android:layout_marginTop="12dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/facultyPassword"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPassword"
                    android:textColor="#1B5E20"
                    android:padding="12dp" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:id="@+id/forgotFacultyPassword"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Forgot Password?"
                android:textColor="#388E3C"
                android:layout_gravity="end"
                android:paddingTop="4dp"/>

            <Button
                android:id="@+id/facultyLoginButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Login"
                android:layout_marginTop="10dp"
                android:backgroundTint="#388E3C"
                android:textColor="#FFFFFF"/>

            <Button
                android:id="@+id/closeFacultyOverlay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Close"
                android:layout_marginTop="5dp"
                android:backgroundTint="#B71C1C"
                android:textColor="#FFFFFF"/>
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
