<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/story_background"
    tools:context=".StoriesActivity">

    <!-- Top Navigation Bar -->
    <LinearLayout
        android:id="@+id/topNav"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="@drawable/img_60"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp">

        <ImageView
            android:id="@+id/backbtn"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/baseline_arrow_circle_left_24"
            android:tint="@android:color/white" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif-black"
            android:gravity="center"
            android:text="Fun Stories 📖"
            android:textColor="@android:color/white"
            android:textSize="22sp" />

        <ImageView
            android:id="@+id/settingsButton"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/outline_apps_24"
            android:tint="@android:color/white" />
    </LinearLayout>

    <!-- 🍬 Candy Filter Bar -->
    <HorizontalScrollView
        android:id="@+id/filterScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/topNav"
        android:scrollbars="none"
        android:paddingVertical="8dp">

        <LinearLayout
            android:id="@+id/filterBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/filterAll"
                style="@style/CandyFilterTab"
                android:text="All" />

            <TextView
                android:id="@+id/filterAnimals"
                style="@style/CandyFilterTab"
                android:text="Animals" />

            <TextView
                android:id="@+id/filterFairyTales"
                style="@style/CandyFilterTab"
                android:text="Fairy Tales" />

            <TextView
                android:id="@+id/filterLessons"
                style="@style/CandyFilterTab"
                android:text="Lessons" />

            <TextView
                android:id="@+id/filterMorals"
                style="@style/CandyFilterTab"
                android:text="Morals" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Scrollable story list -->
    <ScrollView
        android:id="@+id/story_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/filterScroll"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/story_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp" />
    </ScrollView>
</RelativeLayout>
