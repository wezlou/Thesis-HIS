<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/bg_candy_gradient"
    android:padding="18dp">

    <!-- 🍭 Top Navigation -->
    <LinearLayout
        android:id="@+id/topNav"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:background="@drawable/topbar_candy"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:elevation="6dp"
        android:layout_marginBottom="12dp">

        <ImageView
            android:id="@+id/backbtn"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/baseline_arrow_circle_left_24"
            app:tint="#ffffff" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Story Time!"
            android:textColor="@android:color/white"
            android:textSize="24sp"
            android:fontFamily="sans-serif-black" />

        <ImageView
            android:id="@+id/settingsButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/outline_apps_24"
            app:tint="#ffffff" />
    </LinearLayout>

    <!-- 🧁 Story Title -->
    <TextView
        android:id="@+id/storyTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/topNav"
        android:layout_marginTop="10dp"
        android:text="Story Title"
        android:textColor="#FF4081"
        android:textSize="26sp"
        android:textStyle="bold"
        android:fontFamily="casual"
        android:gravity="center" />

    <!-- 📖 Scrollable Story -->
    <ScrollView
        android:id="@+id/storyScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/storyTitle"
        android:layout_above="@id/playButton"
        android:layout_marginTop="10dp"
        android:padding="10dp">

        <TextView
            android:id="@+id/storyContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Story content goes here..."
            android:textSize="18sp"
            android:lineSpacingExtra="6dp"
            android:textColor="#4A4A4A"
            android:fontFamily="serif" />
    </ScrollView>

    <!-- 🍬 Listen Button -->
    <Button
        android:id="@+id/playButton"
        android:layout_width="200dp"
        android:layout_height="60dp"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:text="🎧 Listen"
        android:textSize="20sp"
        android:textColor="@android:color/white"
        android:fontFamily="casual"
        android:background="@drawable/btn_candy_bubble"
        android:elevation="8dp" />
</RelativeLayout>
