<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".VideosActivity">

    <!-- Background -->
    <ImageView
        android:id="@+id/backgroundImage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/vid_back"
        android:scaleType="centerCrop"
        android:alpha="0.9" />

    <FrameLayout
        android:id="@+id/mainContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Top nav -->
        <LinearLayout
            android:id="@+id/topNav"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:background="@drawable/img_60"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp">

            <ImageView
                android:id="@+id/backbtn"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/baseline_arrow_circle_left_24"
                android:contentDescription="Back"
                app:tint="@android:color/white" />

            <TextView
                android:id="@+id/titleText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif-black"
                android:gravity="center"
                android:text="Fun Videos 🎬"
                android:textColor="@android:color/white"
                android:textSize="22sp" />

            <ImageView
                android:id="@+id/settingsButton"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/outline_apps_24"
                android:contentDescription="Settings"
                app:tint="@android:color/white" />
        </LinearLayout>

        <!-- Search bar (kept commented for now) -->
        <!--
        <EditText
            android:id="@+id/searchBar"
            android:layout_width="match_parent"
            android:layout_height="45dp"
            android:layout_marginTop="72dp"
            android:layout_marginHorizontal="12dp"
            android:background="@drawable/rounded_search_bg"
            android:hint="Search videos..."
            android:paddingHorizontal="16dp"
            android:textColor="@android:color/white"
            android:textColorHint="#B3FFFFFF"
            android:inputType="text" />
        -->

        <!-- RecyclerView for the thumbnails -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/videoRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="70dp"
            android:padding="8dp"
            android:clipToPadding="false" />

        <!-- Overlay: Player (hidden by default) -->
        <RelativeLayout
            android:id="@+id/videoOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#CC000000"
            android:visibility="gone"
            android:clickable="true">

            <!-- PlayerView from media3 -->
            <androidx.media3.ui.PlayerView
                android:id="@+id/playerView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_centerInParent="true"
                app:show_buffering="when_playing"
                app:resize_mode="fixed_height" />

            <ProgressBar
                android:id="@+id/videoLoading"
                style="?android:attr/progressBarStyleLarge"
                android:layout_width="70dp"
                android:layout_height="70dp"
                android:layout_centerInParent="true"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/closeOverlayBtn"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_alignParentTop="true"
                android:layout_margin="16dp"
                android:src="@drawable/baseline_arrow_circle_left_24"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Close Video"
                app:tint="@android:color/white" />
        </RelativeLayout>

    </FrameLayout>
</RelativeLayout>
