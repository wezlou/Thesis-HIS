<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@drawable/bg_popup_card"
    android:gravity="center_vertical">

    <!-- Highlighted Title -->
    <TextView
        android:id="@+id/popupTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Task Title Here"
        android:textStyle="bold"
        android:textSize="20sp"
        android:textColor="@android:color/white"
        android:padding="14dp"
        android:gravity="center"
        android:background="@drawable/bg_popup_header"
        android:elevation="3dp" />

    <!-- Teacher -->
    <TextView
        android:id="@+id/popupTeacher"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Teacher: Unknown"
        android:textSize="14sp"
        android:textColor="@android:color/darker_gray" />

    <!-- Content -->
    <TextView
        android:id="@+id/popupContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="This is the full content of the task or announcement."
        android:textSize="16sp"
        android:lineSpacingExtra="4dp"
        android:textColor="@android:color/black" />

    <!-- Date -->
    <TextView
        android:id="@+id/popupDate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="Date: Sep 15, 2025"
        android:textSize="14sp"
        android:textStyle="italic"
        android:textColor="@color/purple_700" />

    <Button
        android:id="@+id/okButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="OK"
        android:backgroundTint="@android:color/holo_blue_dark"
        android:textColor="@android:color/white"
        android:paddingHorizontal="24dp"
        android:paddingVertical="8dp"
        android:layout_gravity="center" />

    <Button
        android:id="@+id/commentButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Comment 💬"
        android:backgroundTint="@color/default_icon"
        android:textColor="@android:color/white"
        android:layout_marginTop="8dp"/>


</LinearLayout>
