<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg">

    <!-- Top Bar -->
    <LinearLayout
        android:id="@+id/topBarTeacher"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:orientation="horizontal"
        android:background="@color/primary"
        android:gravity="center_vertical"
        android:padding="12dp">

        <ImageView
            android:id="@+id/backToTeacherSite"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/baseline_arrow_circle_left_24"
            app:tint="@android:color/white" />

        <TextView
            android:id="@+id/teacherTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Teacher Announcements"
            android:textColor="@android:color/white"
            android:textSize="20sp"
            android:gravity="center" />

        <!-- Create New Announcement -->
        <ImageView
            android:id="@+id/createAnnouncementBtn"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_add"
            app:tint="@android:color/white" />
    </LinearLayout>

    <!-- Announcement List (default visible) -->
    <ScrollView
        android:id="@+id/announcementScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/topBarTeacher"
        android:fillViewport="true"
        android:padding="12dp">

        <LinearLayout
            android:id="@+id/announcementListContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <!-- Empty Message -->
    <TextView
        android:id="@+id/emptyMessageTeacher"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="No announcements yet 📭"
        android:textSize="16sp"
        android:textColor="@android:color/darker_gray"
        android:layout_centerInParent="true"
        android:visibility="gone" />

    <!-- CREATE ANNOUNCEMENT FORM (HIDDEN BY DEFAULT) -->
    <ScrollView
        android:id="@+id/formSection"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/topBarTeacher"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Create Announcement"
                android:textSize="24sp"
                android:textStyle="bold"
                android:paddingBottom="12dp" />

            <EditText
                android:id="@+id/announcementTitleInput"
                android:hint="Title"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:padding="10dp"
                android:background="@drawable/edittext_background" />

            <EditText
                android:id="@+id/announcementContentInput"
                android:hint="Enter announcement..."
                android:layout_width="match_parent"
                android:layout_height="150dp"
                android:padding="10dp"
                android:background="@drawable/edittext_background"
                android:layout_marginTop="12dp"
                android:gravity="top" />

            <LinearLayout
                android:id="@+id/uploadedFilesContainer"
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp" />

            <Button
                android:id="@+id/uploadBtn"
                android:text="Upload File"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/button_primary"
                android:textColor="@color/white" />

            <Button
                android:id="@+id/postAnnouncementBtn"
                android:text="Post Announcement"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/button_primary"
                android:textColor="@color/white" />
        </LinearLayout>
    </ScrollView>

</RelativeLayout>
