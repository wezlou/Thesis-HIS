<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/forestBackground"
    android:fitsSystemWindows="true">

    <!-- TOP BAR -->
    <LinearLayout
        android:id="@+id/topBarTeacher"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:orientation="horizontal"
        android:background="@color/forestPrimary"
        android:gravity="center_vertical"
        android:padding="12dp"
        android:elevation="6dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/backToTeacherSite"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/baseline_arrow_circle_left_24"
            android:tint="@color/forestCard" />

        <TextView
            android:id="@+id/teacherTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Teacher Announcements"
            android:textColor="@color/forestCard"
            android:textSize="20sp"
            android:gravity="center" />

        <ImageView
            android:id="@+id/createAnnouncementBtn"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_add"
            android:tint="@color/forestCard" />

    </LinearLayout>

    <!-- ANNOUNCEMENT LIST -->
    <ScrollView
        android:id="@+id/announcementScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:padding="12dp"
        app:layout_constraintTop_toBottomOf="@id/topBarTeacher"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/announcementListContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <!-- EMPTY MESSAGE -->
    <TextView
        android:id="@+id/emptyMessageTeacher"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="No announcements yet 📭"
        android:textSize="16sp"
        android:textColor="@color/forestMuted"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/topBarTeacher"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- CREATE ANNOUNCEMENT FORM -->
    <ScrollView
        android:id="@+id/formSection"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:padding="16dp"
        app:layout_constraintTop_toBottomOf="@id/topBarTeacher"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Create Announcement"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="@color/forestPrimaryDark"
                android:paddingBottom="12dp" />

            <EditText
                android:id="@+id/announcementTitleInput"
                android:hint="Title"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:padding="12dp"
                android:textColor="@color/forestText"
                android:textColorHint="@color/forestMuted"
                android:background="@drawable/input_rounded" />

            <EditText
                android:id="@+id/announcementContentInput"
                android:hint="Enter announcement..."
                android:layout_width="match_parent"
                android:layout_height="150dp"
                android:padding="12dp"
                android:textColor="@color/forestText"
                android:textColorHint="@color/forestMuted"
                android:gravity="top"
                android:background="@drawable/input_rounded"
                android:layout_marginTop="12dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="20dp"
                android:background="@drawable/card_forest"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Attach Files"
                    android:textSize="16sp"
                    android:textColor="@color/forestPrimaryDark"
                    android:paddingBottom="12dp" />

                <LinearLayout
                    android:id="@+id/uploadContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/input_rounded"
                    android:padding="18dp"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:id="@+id/uploadBtn"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:src="@drawable/ic_upload"
                        android:tint="@color/forestPrimaryDark" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Tap to upload files"
                        android:textSize="14sp"
                        android:textColor="@color/forestMuted" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Attached Files"
                    android:textSize="15sp"
                    android:textColor="@color/forestPrimaryDark"
                    android:paddingTop="20dp"
                    android:paddingBottom="8dp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/forestPrimaryDark" />

                <LinearLayout
                    android:id="@+id/uploadedFilesContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="6dp" />
            </LinearLayout>

            <Button
                android:id="@+id/postAnnouncementBtn"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="Post Announcement"
                android:textColor="@color/forestCard"
                android:textSize="16sp"
                android:layout_marginTop="24dp"
                android:background="@drawable/btn_forest" />
        </LinearLayout>
    </ScrollView>

    <!-- PROGRESS OVERLAY (keeps same ids used in java) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/progressOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:background="#80FFFFFF"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/progressCard"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="22dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/card_forest"
            android:elevation="12dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="220dp"
                android:layout_height="wrap_content"
                style="?android:attr/progressBarStyleHorizontal"
                android:max="100"
                android:progress="0"
                android:indeterminate="false"
                android:padding="0dp" />

            <TextView
                android:id="@+id/progressText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Uploading..."
                android:textColor="@color/forestText"
                android:textSize="16sp"
                android:paddingTop="12dp"
                android:gravity="center" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
