<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="FilterTab">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginEnd">8dp</item>
        <item name="android:padding">8dp</item>
        <item name="android:textColor">#333</item>
        <item name="android:textSize">14sp</item>
        <item name="android:background">@drawable/filter_tab_bg</item>
    </style>

    <style name="CandyFilterTab">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginEnd">12dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:background">@drawable/candy_filter_tab_unselected</item>
        <item name="android:paddingHorizontal">14dp</item>
        <item name="android:paddingVertical">6dp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="FilterPill">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingLeft">16dp</item>
        <item name="android:paddingRight">16dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:textSize">14sp</item>
        <item name="android:background">@drawable/filter_pill_bg</item>
        <item name="android:layout_marginRight">10dp</item>
    </style>

    <style name="AppTheme" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="android:windowBackground">@color/forestBackground</item>
        <item name="colorPrimary">@color/forestPrimary</item>
        <item name="colorPrimaryVariant">@color/forestPrimaryDark</item>
        <item name="colorOnPrimary">@color/forestCard</item>
        <item name="android:textColor">@color/forestText</item>
        <item name="materialCardViewStyle">@style/ForestCard</item>
    </style>

    <style name="ForestCard">
        <item name="cardCornerRadius">16dp</item>
        <item name="cardUseCompatPadding">true</item>
        <item name="cardElevation">6dp</item>
        <item name="cardBackgroundColor">@color/forestCard</item>
    </style>

    <style name="ForestFilterTab">
        <item name="android:padding">10dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:layout_marginEnd">8dp</item>
        <item name="android:background">@drawable/filter_tab_bg</item>
        <item name="android:textColor">@color/forestText</item>
    </style>
</resources>
